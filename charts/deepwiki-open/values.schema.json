{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "service", "persistence", "resources"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"type": "string", "enum": ["", "Always", "IfNotPresent", "Never"]}
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {"type": "array"},
    "revisionHistoryLimit": {"type": "integer", "minimum": 0},
    "strategy": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["Recreate", "RollingUpdate"]}
      }
    },
    "commonLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "automountServiceAccountToken": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "service": {
      "type": "object",
      "required": ["ports"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "ports": {
          "type": "object",
          "required": ["http", "api"],
          "properties": {
            "http": {"type": "integer", "minimum": 1, "maximum": 65535},
            "api": {"type": "integer", "minimum": 1, "maximum": 65535}
          },
          "additionalProperties": false
        },
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["paths"],
            "properties": {
              "host": {"type": "string"},
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": {"type": "string", "pattern": "^/"},
                    "pathType": {"type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"]}
                  }
                }
              }
            }
          }
        },
        "apiPaths": {"type": "array", "items": {"type": "string", "pattern": "^/"}},
        "tls": {"type": "array"}
      },
      "additionalProperties": false
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "parentRefs": {
          "type": "array",
          "items": {"type": "object", "required": ["name"]}
        },
        "hostnames": {"type": "array", "items": {"type": "string"}},
        "apiPaths": {"type": "array", "items": {"type": "string", "pattern": "^/"}},
        "api": {
          "type": "object",
          "properties": {
            "parentRefs": {
              "type": "array",
              "items": {"type": "object", "required": ["name"]}
            }
          }
        }
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"parentRefs": {"minItems": 1}}},
      "additionalProperties": false
    },
    "secret": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "values": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}
      },
      "additionalProperties": false
    },
    "config": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
    "env": {"type": "array", "items": {"type": "object", "required": ["name"]}},
    "envFrom": {"type": "array"},
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"]}
        },
        "size": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "scratchSizeLimit": {"type": "string"},
    "resources": {"type": "object"},
    "probes": {
      "type": "object",
      "properties": {
        "startup": {"$ref": "#/definitions/probe"},
        "liveness": {"$ref": "#/definitions/probe"},
        "readiness": {"$ref": "#/definitions/probe"}
      },
      "additionalProperties": false
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
    "priorityClassName": {"type": "string"},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "extraVolumes": {"type": "array"},
    "extraVolumeMounts": {"type": "array"},
    "tests": {
      "type": "object",
      "properties": {
        "image": {"type": "string", "minLength": 1}
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    }
  }
}
