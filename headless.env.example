# Persistent dataset and published wiki. MCP/CLI use these automatically.
# Relative data paths are anchored at this .env; relative wiki paths at DATA_DIR.
DEEPWIKI_DATA_DIR=/home/ofer_g/.adalflow/headless
DEEPWIKI_WIKI_DIR=wiki
DEEPWIKI_READ_ONLY=false
# Optional writable consumer mappings for an imported portable dataset:
# DEEPWIKI_SOURCE_PATHS='{"stable-repository-id":"/srv/checkouts/project"}'
# Query-only deployments use ~/.cache/codewiki for derived caches, not DATA_DIR.
# Optional absolute per-user writable cache location:
# DEEPWIKI_CACHE_DIR=/home/reader/.cache/codewiki

# Headless scan scope: only these folders beneath the source root.
DEEPWIKI_SCAN_ROOT=/home/ofer_g/projects/ETX_VSC/etxa_devops
DEEPWIKI_SCAN_FOLDERS='["etx_makebuild", "etx_dnfv/etx_dnfv_mng_plane", "etx_unitedbuild"]'

# Generation provider: fill in your Cline API key and exact model ID.
DEEPWIKI_PROVIDER=cline
CLINE_BASE_URL=https://api.cline.bot/api/v1
CLINE_API_KEY=
CLINE_MODEL=
# Example model ID from the Cline docs: anthropic/claude-sonnet-4-6
# Indexing uses Google embeddings, independently of Cline generation.
DEEPWIKI_EMBEDDER_TYPE=google
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_API_KEY=



DEEPWIKI_SCAN_EXTENSIONS='[".c", ".h", ".py", ".sh", ".mk"]'

DEEPWIKI_SCAN_FILENAMES='["Makefile", "makefile", "GNUmakefile", "Makefile.*", "makefile.*"]'

# Pace initial indexing to stay within Google embedding quotas.
GOOGLE_EMBEDDING_MIN_INTERVAL_SECONDS=10

# Enable only after approving source excerpts sent to the generation provider.
DEEPWIKI_ALLOW_SOURCE_EXCERPTS=false

# Optional future migration. Keep token to use the existing index.
DEEPWIKI_CHUNK_STRATEGY=token

# Wiki source export needs separate explicit approval.
DEEPWIKI_ALLOW_WIKI_SOURCE_EXCERPTS=false

# Optional local compiler analysis (profile JSON contains no API keys).
DEEPWIKI_COMPILER_PROFILES=
DEEPWIKI_BUILD_VARIANT=
DEEPWIKI_COMPILER_CONTEXT=false
